{
  "expo": {
    "name": "Pflanzen App",
    "slug": "pflanzen-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a3a2a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pflanzenapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a3a2a"
      },
      "package": "com.pflanzenapp"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a3a2a"
        }
      ]
    ],
    "scheme": "pflanzenapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
